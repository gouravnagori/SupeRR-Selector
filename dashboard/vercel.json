{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/overview", "destination": "/index.html" },
    { "source": "/batters", "destination": "/batters.html" },
    { "source": "/bowlers", "destination": "/bowlers.html" },
    { "source": "/compare", "destination": "/compare.html" },
    { "source": "/pressure-dynamics", "destination": "/pressure-dynamics.html" },
    { "source": "/methodology", "destination": "/methodology.html" },
    { "source": "/rr-fit", "destination": "/rr-fit.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
